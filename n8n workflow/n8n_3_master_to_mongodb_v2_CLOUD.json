    {
      "parameters": {
        "jsCode": "// CANDIDATE_MASTER rows -> MongoDB documents (LinkedIn URL = pehchaan), pool ke hisaab se\nconst now = new Date().toISOString();\nconst NUM = ['total_experience_years', 'domain_experience_years'];\nconst key = k => k.trim().toLowerCase().replace(/\\s*\\/\\s*/g, '_').replace(/[^a-z0-9_]+/g, '_');   // \"modules / specialization\" -> modules_specialization\nreturn $input.all()\n  .map(i => i.json)\n  .filter(r => r.linkedin_url && String(r.linkedin_url).includes('linkedin.com/in/'))\n  .map(r => {\n    const doc = {};\n    for (const [k, v] of Object.entries(r)) if (k !== 'row_number') doc[key(k)] = typeof v === 'string' ? v.trim() : v;\n    doc.linkedin_url = String(doc.linkedin_url).replace('://in.linkedin.com', '://www.linkedin.com').toLowerCase().replace(/\\/+$/, '');\n    for (const k of NUM) doc[k] = doc[k] === '' || doc[k] == null || isNaN(Number(doc[k])) ? null : Number(doc[k]);\n    doc.synced_at = now;\n    return { json: doc };\n  });\n"
      },
      "id": "13c8d92a-b31a-4bc8-9559-9bcb0c2f2456",
      "name": "Prepare docs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        100
      ]
    },
