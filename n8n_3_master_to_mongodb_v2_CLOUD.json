    {
      "parameters": {
        "jsCode": "// CANDIDATE_MASTER rows -> MongoDB documents (LinkedIn URL = pehchaan), pool ke hisaab se\n// INCREMENTAL (4 Nov 2026): har ghante sirf pichle DAYS din me badli rows bhejo. Roz FULL_SYNC_HOUR baje sab rows (jo chhoot gaya wo bhi aa jaaye)\nconst DAYS = 2;               // kitne din purani badli rows bhejni hain\nconst FULL_SYNC_HOUR = 3;     // roz raat 3 baje (IST) poori sheet sync\n// ============================================\nconst nowIst = new Date(Date.now() + 5.5 * 3600e3);\nlet manual = false; try { manual = $execution.mode !== 'production'; } catch (e) {}\nconst full = nowIst.getUTCHours() === FULL_SYNC_HOUR || manual;   // manual run = poori sheet (jab bhi shak ho, manual chala do)\nconst since = new Date(nowIst - DAYS * 864e5).toISOString().slice(0, 10);\nconst now = new Date().toISOString();\nconst NUM = ['total_experience_years', 'domain_experience_years'];\nconst key = k => k.trim().toLowerCase().replace(/\\s*\\/\\s*/g, '_').replace(/[^a-z0-9_]+/g, '_');   // \"modules / specialization\" -> modules_specialization\n// sheet ki date: '2026-11-04' ya number (46330) dono samjho\nconst day = v => { if (v === '' || v == null) return ''; if (typeof v === 'number' || /^\\d{5}(\\.\\d+)?$/.test(String(v))) return new Date(Date.UTC(1899, 11, 30) + Number(v) * 864e5).toISOString().slice(0, 10); return String(v).slice(0, 10); };\n// URL ek hi format me: https://www.linkedin.com/in/<slug> (chhote akshar, koi / ? # nahi, in./uk. -> www.)\nconst normUrl = u => { const m = String(u || '').match(/linkedin\\.com\\/in\\/([^/?#\\s]+)/i); if (!m) return ''; let s = m[1]; try { s = decodeURIComponent(s); } catch (e) {} return `https://www.linkedin.com/in/${s.toLowerCase()}`; };\nconst seen = new Set();\nlet skipped = 0;\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  const url = normUrl(r.linkedin_url || r['LinkedIn URL'] || r.linkedin);\n  if (!url || seen.has(url)) continue;\n  seen.add(url);\n  const doc = {};\n  for (const [k, v] of Object.entries(r)) if (k !== 'row_number') doc[key(k)] = typeof v === 'string' ? v.trim() : v;\n  if (!full) {\n    const changed = [doc.last_updated, doc.first_seen, doc.last_checked].map(day).some(d => d && d >= since);\n    if (!changed) { skipped++; continue; }\n  }\n  doc.linkedin_url = url;\n  for (const k of NUM) doc[k] = doc[k] === '' || doc[k] == null || isNaN(Number(doc[k])) ? null : Number(doc[k]);\n  doc.synced_at = now;\n  out.push({ json: doc });\n}\n// (n8n run me dikhega) kitni rows bheji / chhodi\nif (out.length) out[0].json._sync_note = `${full ? 'FULL' : 'INCREMENTAL since ' + since}: sending ${out.length}, skipped ${skipped} unchanged`;\nreturn out;\n"
      },
