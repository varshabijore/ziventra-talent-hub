    {
      "parameters": {
        "jsCode": "const s = $('Build updates').first().json._stats;\nconst notes = `Apollo: ${s.matched} matched of ${s.requested}, ${s.noMatch} no match, ${s.errors} errors. Emails: ${s.verified} verified, ${s.otherEmail} unverified, ${s.personal} personal. `\n  + `Added to sheet: ${s.emailsAdded} emails. Phones requested: ${s.phonesAsked}. Credits ~${s.credits + s.phonesAsked * 8}${s.errorText ? '. Error: ' + s.errorText : ''}`;\nreturn [{ json: {\n  sheet: { 'Run date': s.stamp, 'Flow': 'n8n (apollo)', 'Queries': 0, 'Google results': '', 'LinkedIn profiles found': s.requested,\n    'Rejected (not India / wrong title / duplicate)': s.noMatch, 'New rows added': `${s.matched} matched`, 'Apify cost ($)': 0, 'Notes': notes },\n  mongo: { run_at: s.stamp, flow: 'n8n (apollo)', found: s.requested, rejected: s.noMatch, added: `${s.matched} matched`, cost: 0,\n    matched: s.matched, emails_added: s.emailsAdded, verified: s.verified, credits: s.credits + s.phonesAsked * 8, notes, error: s.errors && !s.matched ? s.errorText : '' },\n} }];\n"
