    {
      "parameters": {
        "jsCode": "// ===== SETTINGS (sirf yahi badalna hai) =====\nconst MAX = 10;              // ek run me kitne candidates. Roz 1 run. ~9 credits per mobile -> 10 = ~90 credits/din (2,500 credits ~ 27 din)\nconst WANT_PHONE = true;     // Apollo sirf personal mobile number ke liye (email Treg se aata hai)\nconst WANT_EMAIL = false;    // true = Apollo se personal email bhi (1 credit extra)\nconst PHONE_WEBHOOK = '';    // \"Apollo phone webhook\" workflow ka Production URL yahan paste karo (zaroori)\n// ============================================\n\n// ===== saare pools: 4 purane tab + \"Custom\" tab (website par bane pools, pool column ke saath) =====\nconst TABS = [['Read ServiceNow rows', 'ServiceNow'], ['Read AI_ML rows', 'AI_ML'], ['Read Salesforce rows', 'Salesforce'], ['Read Workday rows', 'Workday'], ['Read Custom rows', 'Custom']];\nconst poolName = (tab, r) => tab === 'Custom' ? (r.pool || 'Custom') : tab === 'AI_ML' ? 'AI/ML' : tab;\nconst rowsOf = node => { try { return $(node).all().map(i => i.json); } catch (e) { return []; } };\n// har pool ki apni line (Custom tab me har added pool alag), phir baari-baari se ek-ek: chaaron+ pool barabar\nfunction roundRobin(lists, max) {\n  const picks = [];\n  while (picks.length < max && lists.some(l => l.length)) for (const l of lists) if (l.length && picks.length < max) picks.push(l.shift());\n  return picks;\n}\nfunction byPool(take) {\n  const lists = [];\n  for (const [node, tab] of TABS) {\n    const all = take(rowsOf(node), tab);\n    const groups = {};\n    for (const x of all) (groups[poolName(tab, x.row)] = groups[poolName(tab, x.row)] || []).push(x);\n    lists.push(...Object.values(groups));\n  }\n  return lists;\n}\n// Kaun chuna jaata hai: Enriched + Exact title, jinka Apollo abhi tak check nahi hua, aur jinka phone missing hai\n// (WANT_EMAIL ho to email missing wale bhi).\nconst slug = u => (String(u || '').match(/linkedin\\.com\\/in\\/([^/?#]+)/i) || [])[1]?.toLowerCase() || '';\nconst done = new Set(rowsOf('Read Apollo_results').filter(x => x.matched !== 'Error').map(x => slug(x.linkedin_url)).filter(Boolean));  // error wale dobara try\nconst goodEmail = r => r.email && /^(valid|verified)/i.test(String(r.email_status || '')) && !/guess|check/i.test(String(r.email_status || ''));\nconst score = r => (r.open_to_work === 'Yes' ? 5 : 0) + (!r.email ? 3 : goodEmail(r) ? 0 : 2) + (WANT_PHONE && !r.phone ? 2 : 0)\n  + (/senior|lead|manager/i.test(r.seniority || '') ? 1 : 0) + Math.min(3, Number(r.total_experience_years || 0) / 4);\nconst take = (rows, tab) => rows\n  .filter(r => r.linkedin_url && slug(r.linkedin_url) && !done.has(slug(r.linkedin_url)))\n  .filter(r => ['Enriched', 'Talent-pool ready'].includes(r.readiness) && r.title_match === 'Exact')\n  .filter(r => !/apollo/i.test(String(r.contact_source || '')) && !/apollo checked/i.test(String(r.notes || '')))\n  .filter(r => (WANT_PHONE && !r.phone) || (WANT_EMAIL && !goodEmail(r)))\n  .sort((a, b) => score(b) - score(a))\n  .map(r => ({ tab, row: r }));\nconst picks = roundRobin(byPool(take), MAX);\nif (WANT_PHONE && !PHONE_WEBHOOK.startsWith('https://')) throw new Error('WANT_PHONE true hai lekin PHONE_WEBHOOK khali hai. Webhook workflow ka Production URL paste karo.');\nreturn picks.map(({ tab, row: r }) => {\n  const url = String(r.linkedin_url).replace(/:\\/\\/[a-z]{2}\\.linkedin\\.com/, '://www.linkedin.com').replace(/\\/+$/, '');\n  const parts = String(r.name || '').replace(/\\s+[A-Z]\\.?$/, '').trim().split(/\\s+/);\n  const body = { linkedin_url: url, first_name: parts[0] || undefined, last_name: parts.length > 1 ? parts.slice(1).join(' ') : undefined,\n    organization_name: r.current_company || undefined, reveal_personal_emails: WANT_EMAIL };\n  if (WANT_PHONE && !r.phone) { body.reveal_phone_number = true; body.webhook_url = `${PHONE_WEBHOOK}?li=${encodeURIComponent(r.linkedin_url)}&tab=${tab}`; }\n  return { json: { _tab: tab, _row: r, _phone: WANT_PHONE && !r.phone, body } };\n});\n"
      },
      "id": "056c8720-c3b3-490c-b30d-fe87a365f087",
      "name": "Pick candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1480,
        60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/api/v1/people/match",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cache-Control",
              "value": "no-cache"
            },
            {
              "name": "accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
      "id": "3abb4f10-a9d1-4ce2-a07e-3f29567932c5",
      "name": "Apollo people match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1700,
        60
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Apollo jawab -> (1) sheet tab update  (2) MongoDB apollo_* fields  (3) Apollo_results row  (4) stats\nconst picks = $('Pick candidates').all().map(i => i.json);\nconst res = $input.all().map(i => i.json);\nconst now = new Date(Date.now() + 5.5 * 3600e3);\nconst today = now.toISOString().slice(0, 10), stamp = now.toISOString().slice(0, 16).replace('T', ' ');\nconst norm = u => String(u || '').replace('://in.linkedin.com', '://www.linkedin.com').toLowerCase().replace(/\\/+$/, '');\nconst goodEmail = r => r.email && /^(valid|verified)/i.test(String(r.email_status || ''));\nconst st = { stamp, requested: picks.length, matched: 0, noMatch: 0, errors: 0, verified: 0, otherEmail: 0, personal: 0, emailsAdded: 0, phonesAsked: 0, credits: 0, errorText: '' };\nconst out = [];\npicks.forEach((pk, i) => {\n  const r = pk._row, tab = pk._tab, body = res[i] || {};\n  const p = body.person || null;\n  const err = body.error || body.message || (body.errors && JSON.stringify(body.errors)) || '';\n  const sheet = { linkedin_url: r.linkedin_url, last_updated: today };\n  const mongo = { linkedin_url: norm(r.linkedin_url), apollo_checked_at: stamp };\n  const log = { 'Checked at': stamp, pool: tab === 'Custom' ? (r.pool || 'Custom') : tab === 'AI_ML' ? 'AI/ML' : tab, name: r.name, linkedin_url: r.linkedin_url };\n  if (!p) {\n    if (err) { st.errors++; st.errorText = String(err).slice(0, 200); }\n    else st.noMatch++;\n    Object.assign(mongo, { apollo_status: err ? 'Error' : 'No match' });\n    Object.assign(log, { matched: err ? 'Error' : 'No', 'what changed in sheet': '-', notes: String(err).slice(0, 200) });\n    if (!err) sheet.notes = `${r.notes || ''}; Apollo checked ${today}: no match`.replace(/^; /, '');\n    out.push({ json: { _tab: tab, sheet: err ? null : sheet, mongo, log } });   // error: sheet mat chhuo, agle run me dobara try\n    return;\n  }\n  st.matched++;\n  const email = p.email && !/email_not_unlocked|domain\\.com$/i.test(p.email) ? p.email : '';\n  const es = String(p.email_status || (email ? 'unknown' : 'unavailable')).toLowerCase();\n  const personal = (p.personal_emails || []).find(Boolean) || '';\n  const company = p.organization?.name || (p.employment_history || []).find(e => e.current)?.organization_name || '';\n  const phones = (p.phone_numbers || []).map(x => x.sanitized_number || x.raw_number).filter(Boolean);\n  st.credits += 1;  // Apollo: ~1 credit per matched person (+8 per mobile, counted below)\n  if (pk._phone) st.phonesAsked++;\n  if (personal) st.personal++;\n  const changed = [];\n  if (email && es === 'verified') {\n    st.verified++;\n    if (email.toLowerCase() !== String(r.email || '').toLowerCase() || !goodEmail(r)) {\n      Object.assign(sheet, { email, email_status: 'Verified (Apollo)', contact_source: 'Apollo' }); changed.push('email (verified)'); st.emailsAdded++;\n    }\n  } else if (email) {\n    st.otherEmail++;\n    if (!r.email) { Object.assign(sheet, { email, email_status: `Apollo ${es} - not verified`, contact_source: 'Apollo' }); changed.push('email (not verified)'); st.emailsAdded++; }\n  } else if (personal && !r.email) {\n    Object.assign(sheet, { email: personal, email_status: 'Personal email (Apollo)', contact_source: 'Apollo' }); changed.push('personal email'); st.emailsAdded++;\n  }\n  if (phones[0] && !r.phone) { Object.assign(sheet, { phone: phones[0], phone_status: 'Apollo' }); changed.push('phone'); }\n  if (company && !r.current_company) { sheet.current_company = company; changed.push('company'); }\n  sheet.notes = `${r.notes || ''}; Apollo checked ${today}: ${changed.length ? changed.join(', ') : 'nothing new'}${personal && sheet.email !== personal ? ' | personal email ' + personal : ''}`.replace(/^; /, '');\n  Object.assign(mongo, { apollo_status: 'Matched', apollo_id: p.id || '', apollo_email: email, apollo_email_status: email ? es : 'unavailable',\n    apollo_personal_email: personal, apollo_phone: phones[0] || (pk._phone ? 'requested' : ''), apollo_title: p.title || '', apollo_company: company,\n    apollo_city: [p.city, p.state].filter(Boolean).join(', ') });\n  Object.assign(log, { matched: 'Yes', 'Apollo title / company': [p.title, company].filter(Boolean).join(' / '), 'Apollo email': email, 'email status': email ? es : 'unavailable',\n    'personal email': personal, phone: phones[0] || (pk._phone ? 'requested (webhook)' : ''), 'what changed in sheet': changed.join(', ') || 'nothing', notes: '' });\n  out.push({ json: { _tab: tab, sheet, mongo, log } });\n});\nif (!out.length) return [];\nout[0].json._stats = st;\nreturn out;\n"
      },
