    {
      "parameters": {
        "jsCode": "// Apollo ka phone number webhook -> sheet tab + MongoDB (8 credit per mobile)\nconst q = $input.first().json.query || {}, b = $input.first().json.body || {};\nconst people = b.people || (b.person ? [b.person] : []);\nconst nums = people.flatMap(p => p.phone_numbers || []).sort((x, y) => (y.type_cd === 'mobile') - (x.type_cd === 'mobile'));\nconst phone = nums[0] ? (nums[0].sanitized_number || nums[0].raw_number) : '';\nconst url = String(q.li || '');\nif (!url) return [];\nconst now = new Date(Date.now() + 5.5 * 3600e3).toISOString().slice(0, 16).replace('T', ' ');\nreturn [{ json: { _tab: ['ServiceNow', 'AI_ML', 'Salesforce', 'Workday', 'Custom'].includes(q.tab) ? q.tab : 'ServiceNow', phone,\n  sheet: phone ? { linkedin_url: url, phone, phone_status: `Apollo (${nums[0].type_cd || 'phone'}, ${nums[0].confidence_cd || '-'})` } : null,\n  mongo: { linkedin_url: url.replace('://in.linkedin.com', '://www.linkedin.com').toLowerCase().replace(/\\/+$/, ''), apollo_phone: phone || 'not found', apollo_phone_at: now } } }];\n"
      },
      "id": "5e1d0c5a-9a6f-4778-87c7-2f9e72c16cc6",
      "name": "Read phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ]
