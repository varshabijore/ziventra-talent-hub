    {
      "parameters": {
        "jsCode": "const s = $('Build updates').first().json._stats;\nconst notes = `Treg: ${s.checked} checked. Work emails: ${s.work}, personal emails: ${s.personal}. Added to sheet: ${s.emailsAdded} emails. Cost $${s.cost}${s.errorText ? '. Error: ' + s.errorText : ''}`;\nreturn [{ json: {\n  sheet: { 'Run date': s.stamp, 'Flow': 'n8n (treg)', 'Queries': 0, 'Google results': '', 'LinkedIn profiles found': s.checked,\n    'Rejected (not India / wrong title / duplicate)': 0, 'New rows added': `${s.emailsAdded} emails`, 'Apify cost ($)': s.cost, 'Notes': notes },\n  mongo: { run_at: s.stamp, flow: 'n8n (treg)', found: s.checked, rejected: 0, added: `${s.emailsAdded} emails`, cost: s.cost,\n    checked: s.checked, work_found: s.work, personal_found: s.personal, emails_added: s.emailsAdded, notes,\n    error: s.errors && !s.work && !s.personal && s.errors >= s.checked ? s.errorText : '' },\n} }];\n"
