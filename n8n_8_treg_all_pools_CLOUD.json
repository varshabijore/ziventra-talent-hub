      "id": "5d99880b-c292-4801-b29b-9dc505d93bf8",
      "name": "Treg personal email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        60
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Treg jawab -> (1) sheet tab update  (2) MongoDB treg_* fields  (3) Treg_results row  (4) stats\nconst picks = $('Pick candidates').all().map(i => i.json);\nconst work = $('Treg work email').all().map(i => i.json);\nconst pers = $input.all().map(i => i.json);\nconst now = new Date(Date.now() + 5.5 * 3600e3);\nconst today = now.toISOString().slice(0, 10), stamp = now.toISOString().slice(0, 16).replace('T', ' ');\nconst norm = u => { const m = String(u || '').match(/linkedin\\.com\\/in\\/([^/?#\\s]+)/i); let s = m ? m[1] : ''; try { s = decodeURIComponent(s); } catch (e) {} return s ? `https://www.linkedin.com/in/${s.toLowerCase()}` : ''; };\nconst goodEmail = r => r.email && /^(valid|verified)/i.test(String(r.email_status || '')) && !/guess|check/i.test(String(r.email_status || ''));\nconst hdr = (res, k) => (res && res.headers && (res.headers[k] ?? res.headers[k.toLowerCase()])) || '';\n// one Treg answer -> {email, verified, by, cost, error}\nfunction read(res, asked) {\n  if (!asked) return { email: '', verified: false, by: '', cost: 0, error: '', skipped: true };\n  const b = (res && res.body !== undefined ? res.body : res) || {};\n  const body = typeof b === 'string' ? (() => { try { return JSON.parse(b); } catch { return { error: b }; } })() : b;\n  const code = Number(res && res.statusCode) || 200;\n  const out = body.output || {};\n  const cost = Number(hdr(res, 'x-treg-cost-micro') || body._treg?.cost_micro || 0) / 1e6;\n  const txt = x => (x && typeof x === 'object' ? (x.message || x.detail || x.code || JSON.stringify(x)) : x);\n  const err = code >= 400 || body.error ? `${code >= 400 ? code + ' ' : ''}${txt(body.error) || txt(body.detail) || txt(body.message) || 'HTTP ' + code}`.slice(0, 200) : '';\n  return { email: out.email || '', verified: !!out.verified, by: String(hdr(res, 'x-treg-served-by') || body._treg?.served_by || ''), cost, error: err };\n}\nconst st = { stamp, checked: picks.length, work: 0, personal: 0, emailsAdded: 0, cost: 0, errors: 0, errorText: '' };\nconst out = [];\npicks.forEach((pk, i) => {\n  const r = pk._row, tab = pk._tab;\n  const w = read(work[i], Object.keys(pk.work || {}).length > 0), p = read(pers[i], Object.keys(pk.personal || {}).length > 0);\n  st.cost += w.cost + p.cost;\n  for (const x of [w, p]) if (x.error && !x.skipped) { st.errors++; st.errorText = x.error; }\n  if (w.email) st.work++;\n  if (p.email) st.personal++;\n  const sheet = { linkedin_url: r.linkedin_url, last_updated: today };\n  const changed = [];\n  if (w.email && !goodEmail(r) && (w.verified || !r.email)) {\n    Object.assign(sheet, { email: w.email, email_status: `Treg ${w.verified ? 'verified' : 'found - not verified'}${w.by ? ' (' + w.by + ')' : ''}`, contact_source: 'Treg' });\n    changed.push(w.verified ? 'work email (verified)' : 'work email'); st.emailsAdded++;\n  } else if (p.email && !r.email) {\n    Object.assign(sheet, { email: p.email, email_status: 'Personal email (Treg)', contact_source: 'Treg' }); changed.push('personal email'); st.emailsAdded++;\n  }\n  const errTxt = [w.error && 'work: ' + w.error, p.error && 'personal: ' + p.error].filter(Boolean).join('; ');\n  const failed = errTxt && !w.email && !p.email;   // error: sheet ko mat chhuo, agle run me dobara try hoga\n  if (!failed) sheet.notes = `${r.notes || ''}; Treg checked ${today}: ${changed.length ? changed.join(', ') : errTxt ? 'error' : 'nothing new'}${p.email && sheet.email !== p.email ? ' | personal email ' + p.email : ''}`.replace(/^; /, '');\n  const mongo = { linkedin_url: norm(r.linkedin_url), treg_status: errTxt && !w.email && !p.email ? 'Error' : (w.email || p.email) ? 'Found' : 'Not found',\n    treg_work_email: w.email, treg_work_verified: w.verified ? 'yes' : (w.email ? 'no' : ''), treg_personal_email: p.email,\n    treg_served_by: [w.by, p.by].filter(Boolean).join(', '), treg_cost: Math.round((w.cost + p.cost) * 10000) / 10000, treg_checked_at: stamp };\n  const log = { 'Checked at': stamp, pool: tab === 'Custom' ? (r.pool || 'Custom') : tab === 'AI_ML' ? 'AI/ML' : tab, name: r.name, linkedin_url: r.linkedin_url,\n    'work email': w.email, 'work verified': w.email ? (w.verified ? 'yes' : 'no') : '', 'work served by': w.by, 'personal email': p.email,\n    'personal served by': p.by, 'cost ($)': Math.round((w.cost + p.cost) * 10000) / 10000, 'what changed in sheet': changed.join(', ') || 'nothing', notes: errTxt };\n  out.push({ json: { _tab: tab, sheet: failed ? null : sheet, mongo, log } });\n});\nif (!out.length) return [];\nst.cost = Math.round(st.cost * 10000) / 10000;\nout[0].json._stats = st;\nreturn out;\n"
      },
